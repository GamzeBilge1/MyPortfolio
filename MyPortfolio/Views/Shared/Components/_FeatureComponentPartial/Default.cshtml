@model List<MyPortfolio.DAL.Entities.Feature>
<section id="home" class="s-home page-hero target-section" data-parallax="scroll" data-image-src="https://resmim.net/cdn/2026/10/26/HjAhPq.png" data-natural-width=3000 data-natural-height=2000 data-position-y=center>

    <div class="overlay"></div>
    <div class="shadow-overlay"></div>

    @foreach (var i in Model)
    {
        <div class="home-content">

        <div class="row home-content__main">

            <h3>@i.Title</h3>

                <h1>
                    @foreach (var line in i.Description.Split('.'))
                    {
                        @line
                        <br />
                    }
                </h1>
            <div class="home-content__buttons">
                <a href="#works" class="smoothscroll btn btn--stroke">
                   Son Projelerim
                </a>
                <a href="#about" class="smoothscroll btn btn--stroke">
                    Hakkımda
                </a>
            </div>

            <div class="home-content__scroll">
                <a href="#about" class="scroll-link smoothscroll">
                    <span>Aşağı İn</span>
                </a>
            </div>

        </div>

    </div> <!-- end home-content -->
    }

    @await Component.InvokeAsync("_FeatureSocialMediaComponentPartial")

</section> 